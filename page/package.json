{
    "name": "ngap/page",
    "private": true,
    "scripts": {
        "build": "tsc && vite build"
    },
    "gitHooks": {
        "pre-commit": "lint-staged"
    },
    "lint-staged": {
        "*.{js,jsx,less,md,json}": [
            "prettier --write"
        ],
        "*.ts?(x)": [
            "prettier --parser=typescript --write"
        ]
    },
    "dependencies": {
        "dayjs": "1.11.21",
        "immer": "10.0.3"
    },
    "devDependencies": {
        "@ant-design/colors": "8.0.1",
        "@ant-design/cssinjs": "2.1.2",
        "@typescript-eslint/parser": "6.14.0",
        "@vitejs/plugin-react": "4.2.1",
        "eslint": "8.55.0",
        "less-loader": "12.3.1",
        "path": "0.12.7",
        "prettier": "2.2.0",
        "typescript": "5.9.3",
        "vite-plugin-compression": "0.5.1"
    }
}
