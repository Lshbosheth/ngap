{
    "private": false,
    "name": "ngap",
    "version": "1.0.0",
    "author": {
        "name": "niefuqiang"
    },
    "description": "应用集成平台是一款低代码平台，支持可视化配置、逻辑编排、事件流交互、数据源配置等。",
    "os": [
        "win32",
        "linux"
    ],
    "cpu": [
        "x64",
        "arm64"
    ],
    "scripts": {
        "start": "vite",
        "build:page": "cd ./page && vite build",
        "build": "rimraf dist && rimraf ./node_modules/.cache && npm run build:page && cross-env NODE_ENV=production tsc && vite build",
        "preinstall": "node ./scripts/preinstall.js",
        "prettier": "prettier --write **/*.{js,jsx,tsx,ts,css,less,md,json}"
    },
